# Firebase public web configuration (safe for the browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=undrgrnd-docs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=undrgrnd-docs
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=coryh2014@gmail.com

# Server-side authorization and creator email
FIREBASE_PROJECT_ID=undrgrnd-docs
ADMIN_EMAILS=coryh2014@gmail.com
RESEND_API_KEY=
CREATOR_FROM_EMAIL=UNDRGRND Creators <creators@undrgrnddocs.com>
CREATOR_REPLY_TO=creators@undrgrnddocs.com

# YouTube Data API (server-only)
YOUTUBE_API_KEY=

# Cloudflare R2 media storage (server-only) - NOT provisioned. Catalog video
# streams from Vercel Blob (see HANDOFF.md); only api/r2-upload-url.js reads these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=undrgrnd-media
R2_PUBLIC_URL=https://media.undrgrnddocs.com

# Used by Vercel Cron to authenticate the weekly creator monitor
CRON_SECRET=
